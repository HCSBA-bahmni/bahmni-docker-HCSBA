# Configuracion publica/no sensible del perfil SSO. Copiar como .env.keycloak
# mediante ..\sso.ps1 init. Los secretos se guardan como archivos ignorados.
AUTH_MODE=openmrs
KEYCLOAK_PUBLIC_HOST=sso-dev.hcsba.local
KEYCLOAK_PUBLIC_URL=https://sso-dev.hcsba.local
KEYCLOAK_ADMIN_CIDR=10.68.174.0/24
# Docker Desktop entrega al proxy local la IP de su gateway. En producción,
# reemplazar por la subred exacta del reverse proxy/load balancer confiable.
KEYCLOAK_ADMIN_PROXY_CIDR=172.16.0.0/12
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_BOOTSTRAP_ADMIN=kc-bootstrap-admin
KEYCLOAK_LOOPBACK_PORT=18080
BAHMNI_PUBLIC_URL=https://10.68.174.205
BAHMNI_LOCAL_DEV_URL=https://localhost
# URL alcanzable por Keycloak para invalidar sesiones OpenMRS. En un despliegue
# compartido debe resolver al backend OpenMRS, no a la aplicación Next.js.
OPENMRS_BACKCHANNEL_LOGOUT_URL=https://10.68.174.205/openmrs/oauth2backchannellogout
OPENMRS_UPSTREAM_HOST=10.68.174.205
OPENMRS_UPSTREAM_PORT=443
OPENMRS_UPSTREAM_TLS_VERIFY=false
KEYCLOAK_TLS_CERTIFICATE_PATH=./keycloak/tls/sso-dev-cert.pem
KEYCLOAK_TLS_KEY_PATH=./keycloak/tls/sso-dev-key.pem
