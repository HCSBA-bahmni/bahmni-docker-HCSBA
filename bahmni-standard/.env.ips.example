# Opt-in. The base development environment remains unchanged while false.
IPS_MEDIATOR_ENABLED=false
BAHMNI_PUBLIC_ORIGIN=https://localhost

# IPS upstream origin only, without /regional, /vhl or credentials.
IPS_UPSTREAM_BASE=https://ips.example.internal:5000
IPS_UPSTREAM_TLS_SKIP_VERIFY=false

# OpenMRS session introspection. The mediator forwards the browser JSESSIONID
# only to this URL and never to the IPS upstream.
IPS_OPENMRS_SESSION_URL=https://openmrs.example.internal/openmrs/ws/rest/v1/session?v=custom:(authenticated,user:(uuid,privileges:(name)))
IPS_OPENMRS_REQUIRED_PRIVILEGE=app:clinical

# Use absolute host paths. Their files are ignored by Git and mounted as
# Docker secrets; never place either value in this environment file.
IPS_UPSTREAM_USERNAME_FILE=C:/absolute/path/to/ips-mediator/secrets/upstream-username
IPS_UPSTREAM_PASSWORD_FILE=C:/absolute/path/to/ips-mediator/secrets/upstream-password
